# .claudeignore — keeps noise, build artifacts, and large/secret files out of
# Claude Code's context window. Mirrors .gitignore in spirit but is tuned for
# token budget: anything here will NOT be read into context during exploration.
# (This does NOT affect git or deployment — it only scopes what Claude sees.)

# ── PHP / Laravel dependencies (regenerated by `composer install`) ──
/vendor/

# ── Node / frontend dependencies (regenerated by `npm install`) ──
/node_modules/
../croose_frontend/node_modules/

# ── Build output (regenerated by Vite / Next build; never authored by hand) ──
/public/build/
/public/hot
../croose_frontend/.next/
../croose_frontend/out/

# ── Laravel framework-generated caches & compiled files ──
/bootstrap/cache/
/storage/framework/
/storage/debugbar/

# ── Logs (high-churn, low-signal) ──
/storage/logs/
*.log
npm-debug.log*
yarn-error.log*

# ── Local SQLite database (binary, large, not source) ──
/database/database.sqlite
*.sqlite
# NOTE: database/migrations/ is intentionally NOT ignored — migrations are
# source of truth for the schema and must stay visible to Claude.

# ── Test coverage / build reports ──
/coverage/
/.phpunit.cache/
.phpunit.result.cache
clover.xml

# ── Lock files (huge, machine-generated; the manifest files are enough) ──
composer.lock
package-lock.json
yarn.lock
bun.lock
pnpm-lock.yaml

# ── Secrets & environment (NEVER load real env into context) ──
.env
.env.*
!.env.example

# ── Media / large binary uploads (no code value, burns tokens) ──
/storage/app/public/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp3
*.mp4
*.pdf
*.zip

# ── Dead backup copies — do NOT read or edit these (see CODEBASE_AUDIT.md) ──
/app1/
/app2/
/app.zip

# ── IDE / OS cruft ──
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
